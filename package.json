{
  "name": "forma-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "backend": "npm --prefix backend run start:dev",
    "start:backend": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "migrate:h2": "npm --prefix backend run migrate:h2 --",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend"
  }
}
